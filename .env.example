# APP
APP_NAME=Core Backend
APP_DESCRIPTION=Core Backend Description
APP_VERSION=1.0
APP_PORT=3000
APP_PREFIX=api
APP_ENV=development

# MACHINE LEARNING PREDICTION API
PREDICTION_API_URL=http://localhost:3002/api/v1/prediction/predict
PREDICTION_API_KEY=replace_with_prediction_api_key
PREDICTION_API_TIMEOUT_MS=10000

# DATABASE Orcale
DB_CONNECT_STRING=localhost:1521/XEPDB1
DB_USERNAME=oracle_user
DB_PASSWORD=oracle_password
ORACLE_SCHEMA=NOMBRE_SCHEMA
DB_LOGGING=false

# FRONTEND
# FRONTEND_URL=http://localhost:8081

# CORS
CORS_ORIGINS=http://localhost:8081
CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Accept
CORS_ALLOW_CREDENTIALS=false

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# BCRYPT
BCRYPT_SALT_ROUNDS=12

# LOGGING
LOG_LEVEL=debug
